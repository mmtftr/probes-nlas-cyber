# [ai-generated]
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.local

# data/ is local scratch / cache. Track only the README scaffold;
# payloads (npz, jsonl, parquet, png, ...) never get committed.
data/**/*
!data/**/
!data/**/README.md

# wandb local state
wandb/

# notebook scratch outputs
*.ipynb_checkpoints/

# notebook sample payloads (binaries stay local; small JSON scaffold is tracked)
notebooks/**/data/*.npz
notebooks/**/data/*.npy
notebooks/**/data/*.jsonl
notebooks/**/data/*.parquet
notebooks/**/data/*.pt

# OS
.DS_Store

# Regenerable experiment payloads — kept out of the published repo
*.npz
*.tgz
**/run.log
plans/**/*_dataset.jsonl
plans/**/dataset_*.jsonl

# Generated reports (regenerate from .typ / .md / .qmd sources)
docs/project-log.pdf
plans/**/report.pdf
docs/presentations/**/slides.pdf
docs/presentations/**/slides.html
docs/blog/*.pdf

# vLLM / extra deps installed off-tree
.deps_vllm/
.python_deps*/

# Local agent notes (publish-hygiene pointers) — never publish
CLAUDE.local.md
AGENTS.local.md
