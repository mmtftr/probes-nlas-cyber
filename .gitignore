# [ai-generated]
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.local

# data/ is local scratch / cache. Track only the README scaffold;
# payloads (npz, jsonl, parquet, png, ...) never get committed.
data/**/*
!data/**/
!data/**/README.md

# wandb local state
wandb/

# notebook scratch outputs
*.ipynb_checkpoints/

# notebook sample payloads (binaries stay local; small JSON scaffold is tracked)
notebooks/**/data/*.npz
notebooks/**/data/*.npy
notebooks/**/data/*.jsonl
notebooks/**/data/*.parquet
notebooks/**/data/*.pt

# OS
.DS_Store
